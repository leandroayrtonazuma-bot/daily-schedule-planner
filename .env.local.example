# このファイルを .env.local にコピーして値を埋める。
# 何も設定しなければモックモードで動くので、まずはコピーせずに npm run dev でよい。

# --- Supabase --------------------------------------------------------------
# Supabase ダッシュボード → Project Settings → API から取得する。
# この2つが揃った時点で live モードに切り替わる。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側でのみ使う。NEXT_PUBLIC_ を付けてはいけない（PLAN.md 10.3）。
# Phase 1 では未使用。
SUPABASE_SERVICE_ROLE_KEY=

# --- 動作モードの手動指定 --------------------------------------------------
# 未設定なら上の環境変数の有無から自動判定する。
# 'mock' にすると Supabase を設定していても強制的にモックで動く。
# APP_MODE=mock

# --- Claude API ------------------------------------------------------------
# Phase 5（タスク分解）で使う。サーバー側のみ。
# ANTHROPIC_API_KEY=
